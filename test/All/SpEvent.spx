import "fmt"

var (
	hasStarted        bool
	score             = 0
	scoreReachedCount int
)

func triggerScoreCondition(expectedCount int) {
	score = 0
	for score < 3 {
		score++
		waitNextFrame
	}
	for scoreReachedCount < expectedCount {
		waitNextFrame
	}
	assert(scoreReachedCount == expectedCount,
		"Sprite::OnCond trigger count = %d, want %d", scoreReachedCount, expectedCount)
}

onCond score >= 3, => {
	scoreReachedCount++
	say fmt.Sprintf("Condition trigger count: %d", scoreReachedCount)
}

onKey KeyY, => {
	hasInputKey = true
}

onClick => {
	hasClicked = true
}

onBackdrop "backdrop2", => {
	hasChangedBackdrop = true
}

onMsg "msgA", => {
	hasReceivedMsgA = true
}

onMsg "msgB", => {
	hasReceivedMsgB = true
}

onMsg "syncMsg", => {
	wait 0.05s
	hasSyncMsgSprite = true
}

onStart => {
	hasStarted = true
}

// Not support
// onLoudness =>{}

onMsg "testSyncEvent", => {
	onTestStart(this)

	hasSyncMsgSprite = false
	hasSyncMsgStage = false
	broadcastAndWait "syncMsg"
	assert(hasSyncMsgSprite, "Sprite::broadcastAndWait should wait for sprite handlers")
	assert(hasSyncMsgStage, "Sprite::broadcastAndWait should wait for stage handlers")

	hasTestDone = true
}

onMsg "testEvent", => {
	onTestStart(this)

	// 1. Sprite::onKey
	say "Please press key 'y'"
	for !hasInputKey {
		waitNextFrame
	}

	// 2. Sprite::onClick
	say "Please click the monkey "
	for !hasClicked {
		waitNextFrame
	}
	say ""

	// 3. Sprite::onStart, onCond
	wait 0.1s
	assert(hasStarted, "Sprite::OnStart")

	triggerScoreCondition 1
	wait 1
	assert(scoreReachedCount == 1, "Sprite::OnCond should not repeat while true")

	triggerScoreCondition 2
	wait 1

	// 4. Sprite::onBackdrop
	setBackdrop "backdrop2"
	wait 0.1s
	for !hasChangedBackdrop {
		waitNextFrame
	}

	// 5. Sprite::onMsg
	broadcast "msgA"
	wait 0.1s
	assert(hasReceivedMsgA, "Sprite::OnMsg send to self")
	broadcast "msgB"
	wait 0.1s
	assert(hasReceivedMsgB, "Sprite::OnMsg send to other sprite")

	onTestDone(this)
}
