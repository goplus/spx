onStart => {
	println "AnimationOnPlayLoopFalse demo"
	println "The tested flag is fAnimations.*.onPlay.loop in sprite config"
	println "The animate(..., true) call only keeps the animation cycling"
	println "F: replay on each animation cycle with onPlay loop:false"
	println "G: compare with onPlay loop:true"
	println "S: stop animation"

	animate "clapLoopFalse", true
	say "onPlay loop:false"
}

onKey KeyF, => {
	stopAnimation "clapLoopTrue"
	animate "clapLoopFalse", true
	say "onPlay loop:false"
}

onKey KeyG, => {
	stopAnimation "clapLoopFalse"
	animate "clapLoopTrue", true
	say "onPlay loop:true"
}

onKey KeyS, => {
	stopAnimation "clapLoopFalse"
	stopAnimation "clapLoopTrue"
	say "stopped"
}
