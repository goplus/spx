// memory allocator for wrap codes
EMSCRIPTEN_KEEPALIVE
void* cmalloc(int size) {
	auto ptr = malloc(size);
	return ptr;
}
EMSCRIPTEN_KEEPALIVE
void cfree(void* ptr) {
	free(ptr);
}

