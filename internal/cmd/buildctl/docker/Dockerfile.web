ARG img_version
FROM godot-fedora:${img_version}

# Legacy/unsupported image: this historical emsdk pin is intentionally isolated
# from the runtime.lock.json-driven buildctl build path.
ENV EMSCRIPTEN_VERSION=3.1.62

RUN git clone --branch ${EMSCRIPTEN_VERSION} --progress https://github.com/emscripten-core/emsdk && \
    emsdk/emsdk install ${EMSCRIPTEN_VERSION} && \
    emsdk/emsdk activate ${EMSCRIPTEN_VERSION}

CMD /bin/bash
